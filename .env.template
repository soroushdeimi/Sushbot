# =============================================================================
# SushBotSeller - Environment Variables Template
# =============================================================================
# 
# IMPORTANT: Before deploying, copy this to .env and fill in real values:
#   cp .env.template .env
#
# NEVER commit .env to version control!
# =============================================================================

# Telegram Bot Configuration (REQUIRED)
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/sushbotseller
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# PasarGuard Integration
PASARGUARD_API_URL=
PASARGUARD_NODE_ID=3
PASARGUARD_DEFAULT_PROTOCOL=vless
PASARGUARD_DEFAULT_PORT=8443
PASARGUARD_USERNAME=admin
PASARGUARD_PASSWORD=

# Security (Auto-generated if empty, but set fixed values for production!)
SECRET_KEY=
JWT_SECRET=
ENCRYPTION_KEY=
PHONE_VERIFICATION_ENABLED=true
RATE_LIMIT_PER_MINUTE=20

# Admin Configuration (REQUIRED)
# Get your Telegram ID from @userinfobot
# Set to 0 to auto-promote first user who runs /start
SUPER_ADMIN_TELEGRAM_ID=0
# Additional admin IDs (comma-separated, e.g., 123456789,987654321)
ADMIN_IDS=

# Channel Membership (optional)
REQUIRED_CHANNEL_USERNAME=
REQUIRED_CHANNEL_ID=

# Trial Settings
TRIAL_ENABLED=true
TRIAL_DURATION_DAYS=1
TRIAL_TRAFFIC_GB=5

# Payment Gateways (optional)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
AQAYEPARDAKHT_API_KEY=
AQAYEPARDAKHT_GATEWAY_ID=
CARD_TO_CARD_NUMBER=
CARD_TO_CARD_OWNER=

# Public URL for webhooks/subscription links
PUBLIC_BASE_URL=

# Web Panel
WEB_PANEL_ENABLED=true
WEB_PANEL_PORT=8080
# Use 127.0.0.1 for local development (secure default)
# Use 0.0.0.0 for Docker/container deployments to expose externally
WEB_PANEL_HOST=127.0.0.1

# SSL Verification for Admin Panel API Calls
# Set to false for self-hosted panels with self-signed certificates
PANEL_SSL_VERIFY=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/sushbotseller.log

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Timezone
TIMEZONE=Asia/Tehran

# Feature Flags
SUBSCRIPTION_VERSION=false
RESELLER_ENABLED=false
BULK_PURCHASE_ENABLED=true

# =============================================================================
# FEATURE FLAGS - Easy enable/disable for all features
# =============================================================================
# All features default to true (enabled). Set to false to disable.
# See config/features.py for full documentation.

# Core Features
FEATURE_PURCHASE=true
FEATURE_TRIAL=true
FEATURE_SERVICES=true
FEATURE_SUPPORT=true
FEATURE_WALLET=true
FEATURE_DISCOUNT=true
FEATURE_AFFILIATE=true
FEATURE_CONTENT_CMS=true

# Protocol Selection (NEW!)
# Allow users to choose VPN protocol (VLESS/VMESS/Trojan) before purchase
FEATURE_PROTOCOL_SELECTION=true

# Verification Requirements
FEATURE_PHONE_VERIFICATION=true
FEATURE_CHANNEL_MEMBERSHIP=false
FEATURE_REQUIRE_PHONE_FOR_PURCHASE=true
FEATURE_REQUIRE_PHONE_FOR_TRIAL=true
FEATURE_REQUIRE_CHANNEL_FOR_PURCHASE=true
FEATURE_REQUIRE_CHANNEL_FOR_TRIAL=false

# Payment Methods
FEATURE_PAY_CARD_TO_CARD=true
FEATURE_PAY_NOWPAYMENTS=true
FEATURE_PAY_AQAYEPARDAKHT=true
FEATURE_PAY_RIAL_EXCHANGE=false

# Admin Features
FEATURE_ADMIN_WEB=true
FEATURE_ADMIN_TELEGRAM=true
FEATURE_REPORTING=true

# Advanced Features
FEATURE_INVENTORY=true
FEATURE_RESELLER=false
FEATURE_BULK_PURCHASE=false
FEATURE_REFUNDS=false
FEATURE_SERVICE_REMOVAL=false
FEATURE_SERVICE_TRANSFER=false
FEATURE_SERVICE_LOCATION_CHANGE=false

# Notifications
FEATURE_EXPIRY_REMINDERS=true
FEATURE_LOW_TRAFFIC_ALERTS=true
FEATURE_ADMIN_NOTIFICATIONS=true

# Multi-Panel Support
FEATURE_MULTI_PANEL=true
FEATURE_USAGE_SYNC=true

# Affiliate Settings
AFFILIATE_ENABLED=true
AFFILIATE_FIRST_PURCHASE_ONLY=true
AFFILIATE_COMMISSION_PERCENT=5
